# DocuMind AI / NexusRAG Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Google Gemini API Configuration (Get key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Qdrant Vector Database Configuration
# Local Qdrant: http://localhost:6333
# Qdrant Cloud: https://<cluster-id>.<region>.<cloud-provider>.cloud.qdrant.io:6333
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=DocuMind

# Server Configuration
PORT=5000
NODE_ENV=development
