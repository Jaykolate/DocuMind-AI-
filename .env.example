# NexusRAG Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Google Gemini API Configuration (Mandatory for live LLM generation & embeddings)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBU3pvOuDkDElFX3eude7XnPAUTtSnqgxk
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Qdrant Vector Database Configuration
# Local Qdrant: http://localhost:6333 (No API key needed)
# Qdrant Cloud: https://xxxx-xxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# If left blank or unreachable, NexusRAG gracefully falls back to high-performance in-memory vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6MmFhZTNiNzAtYWNiNi00Mjg3LWEwNTctMjVlYWFhNDhjMDFmIn0.2kVozY90Z-dUHU7W5Z2S1C3hVmIeXeD0rp2qQxlmNDw
QDRANT_COLLECTION_NAME=DocuMind

# Server Configuration
PORT=5000
NODE_ENV=development
