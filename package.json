{
  "name": "nexusrag-workspace",
  "version": "1.0.0",
  "description": "NexusRAG — Agentic Knowledge Retrieval & Intelligence Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npm run dev:server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "test": "npm run test:server",
    "lint": "npm run lint --prefix server && npm run lint --prefix client"
  },
  "keywords": [
    "rag",
    "gemini",
    "qdrant",
    "vector-search",
    "knowledge-retrieval",
    "langchain"
  ],
  "author": "NexusRAG Team",
  "license": "MIT"
}
